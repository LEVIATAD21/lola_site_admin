# LOLA ADMIN BFF — variáveis exclusivas do servidor.
# NUNCA prefixe estas variáveis com VITE_: isso as expõe no navegador.
NODE_ENV=development
HOST=127.0.0.1
PORT=4101

# Credencial do operador (MVP de operador único; não é MFA).
LOLA_ADMIN_USERNAME=operador
LOLA_ADMIN_PASSWORD=SUBSTITUA_POR_SENHA_FORTE_COM_16_OU_MAIS_CARACTERES

# Gere com: openssl rand -hex 32
LOLA_ADMIN_SESSION_SECRET=SUBSTITUA_POR_SEGREDO_ALEATORIO_DE_64_CARACTERES_HEXADECIMAIS

# Endereço do Data Server do LOLA SITE.
LOLA_DATA_SERVICE_URL=http://127.0.0.1:4100

# Deve ser a mesma chave configurada no Data Server, mantida apenas no servidor.
LOLA_ADMIN_API_KEY=SUBSTITUA_PELA_CHAVE_ADMINISTRATIVA_DO_DATA_SERVER

# Em produção, o BFF deve ficar atrás de proxy HTTPS:
# NODE_ENV=production
# LOLA_ADMIN_COOKIE_SECURE=true
# LOLA_ADMIN_BEHIND_HTTPS_PROXY=true
